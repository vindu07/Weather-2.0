<properties xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- colori -->
    
    <property id="FieldColor" type="number">0xAAAAAA</property>
    <property id="TimeColor" type="number">0xFFFFFF</property>
    <property id="IconColor" type="number">0xFFAA00</property>

    
    <!-- booleani -->
    
    <property id="UseMilitaryFormat" type="boolean">false</property>
    <property id="RemoveZerosFromHour" type="boolean">false</property>

    <property id="EnergySavingMode" type="boolean">false</property>

    <property id="VibrationBeforeSunset" type="boolean">true</property>
   
    <property id="DynamicSkyColor" type="boolean">true</property>
    <property id="DynamicSunPosition" type="boolean">true</property>

    <property id="ShowWeather" type="boolean">true</property>
    <property id="ShowIcons" type="boolean">true</property>
    <property id="ShowBatteryIcon" type="boolean">true</property>
    <property id="ShowDataFields" type="boolean">true</property>
    <property id="ShowInfoFields" type="boolean">true</property>

   
    <!-- preferenze utente -->

    <property id="PressUnit" type="number">0</property>

    <property id="LandscapeType" type="number">0</property>

    <property id="DefaultPositionLat" type="float">46.0</property>
    <property id="DefaultPositionLon" type="float">11.0</property>

    <!-- FONT -->

    <property id="TimeFont" type="number">0</property>
    <property id="DateFont" type="number">0</property>
    <property id="FieldFont" type="number">0</property>

     
     
    <!-- indicatore batteria -->

    <property id="BatteryIndicatorFullColor" type="number">0x00FF00</property>
    <property id="BatteryIndicatorGoodColor" type="number">0xFFFFFF</property>
    <property id="BatteryIndicatorMedColor" type="number">0xFFAA00</property>
    <property id="BatteryIndicatorLowColor" type="number">0xFF0000</property>
    <property id="BatteryIndicatorExtremelyLowColor" type="number">0xFF0000</property>

    <property id="BatteryIndicatorFull" type="number">80</property>
    <property id="BatteryIndicatorGood" type="number">50</property>
    <property id="BatteryIndicatorMed" type="number">20</property>
    <property id="BatteryIndicatorLow" type="number">10</property>
    
    
    <!-- info e campi dati -->

    <property id="InfoField1" type="number">1</property>
    <property id="InfoField2" type="number">23</property>
    <property id="InfoField3" type="number">19</property>
    <property id="InfoField4" type="number">26</property>

    <property id="DataField1" type="number">2</property>
    <property id="DataField2" type="number">7</property>
    <property id="DataField3" type="number">11</property>
    

</properties>
