<layout id="WatchFace" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    
<!--BACKGROUND-->

        <drawable id="Sky" class="Sky">
			<param name="height">120</param>
		</drawable>
        <drawable id="SunOrMoon" class="SunOrMoon">
			<param name="xCenter">130</param>
            <param name="yCenter">100</param>
			<param name="radius">80</param>
		</drawable>
		<drawable id="CustomWeather" class="CustomWeather">
			
		</drawable>
        <drawable id="Landscape" class="Landscape">
			<param name="x">-10</param>
			<param name="y">-20</param>
		</drawable>
        


